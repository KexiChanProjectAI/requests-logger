# Proxy Configuration
LISTEN_ADDR=:8080
UPSTREAM_BASE_URL=https://api.openai.com
LOG_SERVER_URL=http://localhost:8081
LOG_SERVER_TOKEN=change-me
LOG_QUEUE_SIZE=1024
CAPTURE_MAX_BYTES=0
